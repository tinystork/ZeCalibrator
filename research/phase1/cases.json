    "flat_flatdark_incl_bias": "Fcorr = Finc - FDinc",
    "flat_flatdark_bias_removed": "Fcorr = Finc - Bflat - FD0",
    "flat_bias_only": "Fcorr = Finc - Bflat",
    "flat_already_corrected": "consume R directly",
    "flat_normalize_mono": "s = median(valid Fcorr); R = Fcorr / s",
    "flat_normalize_cfa": "s[p] per parity plane; R[y,x] = Fcorr[y,x] / s[parity(y,x)]",
    "final_with_flat": "C = A / R",
    "final_no_flat": "C = A",
    "flat_only_partial": "A = L; C = L / R"
  },
  "reason_code_registry": {
