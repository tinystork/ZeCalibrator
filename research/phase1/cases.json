    "GAIN_MISMATCH": "gain differs",
    "OFFSET_MISMATCH": "offset differs",
    "READOUT_MISMATCH": "readout mode differs",
    "ADC_MISMATCH": "ADC/acquisition mode differs",
    "EXPOSURE_MISMATCH": "exposure outside serialization tolerance",
    "TEMPERATURE_MISMATCH": "temperature outside zero + parser tolerance",
    "FILTER_MISMATCH": "flat filter differs (flat only)",
    "OPTICAL_TRAIN_MISMATCH": "flat optical train differs (flat only)",
    "MISSING_REQUIRED_FIELD": "required matching field absent and no qualified declaration",
    "UNKNOWN_EQUALS_UNKNOWN": "two unknown values never match automatically",
    "ALIAS_CONFLICT": "duplicate/contradictory aliases disagree",
    "UNDOCUMENTED_PROCESSING": "undocumented master processing or processed history",
    "SATURATED_FLAT": "flat normalization population empty or below quality gate",
    "FLAT_UNUSABLE": "flat has zero valid samples in a required plane",
    "FLAT_ADDITIVE_DEPENDENCY_MISSING": "flat's own flat-dark/bias dependency missing",
